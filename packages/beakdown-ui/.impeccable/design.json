  "narrative": {
    "northStar": "Starchy Gooey drafting ground",
    "overview": "Beakdown adopts the selected shared Starchy Gooey system. A neutral drafting ground holds heavy translucent chrome, crisp black actions and restrained red signals. Soft material and fluid selection frame a precise, information-dense tool; evidence and computed results remain the foreground.\n\nThe system supports inspection and correction. Screenshots, confidence labels, provenance and real execution results must remain distinguishable and legible inside the same material language. The product commitments are recorded in [PRODUCT.md](PRODUCT.md).",
    "keyCharacteristics": [
      "Neutral drafting ground and black ink.",
      "Heavy glass for chrome; opaque surfaces for evidence and computation.",
      "Fluid capsule selection with explicit selected states.",
      "Geist for reading; Geist Mono for code and execution facts."
    ],
    "rules": [
      {
        "name": "The Signal Rule",
        "body": "Use red to locate a selected item or an evidence connection; keep long reading surfaces neutral.",
        "section": "colors"
      },
      {
        "name": "The Readable Graph Rule",
        "body": "Preserve readable node titles when fitting a graph. The current graph reserves (180px) height and initially fits between (0.85) and (1) zoom; overflow remains navigable.",
        "section": "typography"
      },
      {
        "name": "The Material Boundary Rule",
        "body": "Apply glass to framing chrome; keep captured evidence, code and results sharp on opaque surfaces.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reuse the selected Starchy Gooey materials, Geist pairing and neutral ground.",
      "Do distinguish semantic confidence, evidence selection and computation selection through words and state as well as color.",
      "Do preserve navigable overflow and readable graph text across viewport sizes.",
      "Do keep keyboard focus and reduced-motion behavior on new controls."
    ],
    "donts": [
      "Don't substitute a new visual identity for the adopted shared system.",
      "Don't blur screenshots, code, table values or selected labels with the glass treatment.",
      "Don't promote incidental tiny metadata sizes or unused legacy selectors into reusable system roles."
    ]
  }
}
